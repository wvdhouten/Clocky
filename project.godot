; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/bg_color=Color(0.47451, 0.776471, 0.964706, 1)
boot_splash/show_image=false
config/name="Clocky"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/windows_native_icon="res://assets/icon/clocky.ico"
config/quit_on_go_back=false

[autoload]

UiTheme="*res://autoloads/UiTheme.gd"
GameState="*res://autoloads/GameState.gd"
ProgressStore="*res://autoloads/ProgressStore.gd"
SoundFx="*res://autoloads/SoundFx.gd"
KioskWindow="*res://autoloads/KioskWindow.gd"
LocaleManager="*res://autoloads/LocaleManager.gd"
Speech="*res://autoloads/Speech.gd"
ExerciseDirector="*res://autoloads/ExerciseDirector.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/ui_strings.en.translation", "res://localization/ui_strings.nl.translation", "res://localization/ui_strings.ro.translation")
locale/fallback="en"

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
